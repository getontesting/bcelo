# Salin ke .env lalu isi. JANGAN pernah commit .env yang berisi private key.

# --- Dompet agent (taker) ---
TAKER_PRIVATE_KEY=0x2Ff10a4748902E82E82835Edef6d98c306e4ba38
PAYOUT_ADDRESS=0x2Ff10a4748902E82E82835Edef6d98c306e4ba38

# --- Attribution code (WAJIB pakai kode yang diasign saat enroll) ---
# Untuk dev lokal sebelum enroll, boleh pakai celo_test1234
ATTRIBUTION_CODE=celo_test1234
# Dipakai untuk sanity-check codeFromRepo("owner/repo")
GITHUB_REPO=owner/repo
# Diisi otomatis setelah `python -m src.cli register-agent`
AGENT_ID=
# Nama endpoint agent untuk file registrasi ERC-8004
AGENT_ENDPOINT=https://github.com/owner/repo

# --- Jaringan: Celo mainnet ONLY untuk dihitung ---
CELO_RPC_URL=https://forno.celo.org
CHAIN_ID=42220

# --- Textile FX ---
# Kosongkan untuk jalur keyless (takerProof EIP-712 otomatis).
# Kalau pakai API key, jangan kirim includeAttribution (biar tag kita yang terakhir).
TEXTILE_API_KEY=
TEXTILE_API_URL=https://api.textilecredit.com/v2

# --- Alur Track 1: USD₮ -> IDRX, lalu bayar penerima eksternal ---
# Alamat token Celo mainnet (sudah benar, jangan diubah kecuali pindah koridor)
SELL_TOKEN=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
BUY_TOKEN=0x18Bc5bcC660cf2B9cE3cd51a404aFe1a0cBD3C22
# Dalam unit atomik. USD₮ pakai 6 desimal -> 10000000 = 10 USD₮
SELL_AMOUNT_ATOMIC=10000000
# Wallet di luar tim dan TIDAK kamu fund sebelumnya.
RECIPIENT_ADDRESS=0xEXTERNAL_RECIPIENT_WALLET

# --- Track 2a: Agent Vault (MCP server resmi, butuh API key dari dashboard) ---
AGENTVAULT_API_KEY=
AGENTVAULT_PROXY_URL=wss://proxy.agentvault.io/v1
AGENTVAULT_API_URL=https://api.agentvault.io
AGENTVAULT_SIGNIN_URL=https://example.com/login
AGENTVAULT_USERNAME_SELECTOR=input[type='email']
AGENTVAULT_USERNAME_TOKEN=av_login_xxx_email_xxxxx
AGENTVAULT_PASSWORD_SELECTOR=input[type='password']
AGENTVAULT_PASSWORD_TOKEN=av_login_xxx_password_xxxxx
AGENTVAULT_SUBMIT_SELECTOR=button[type='submit']
AGENTVAULT_SUCCESS_SELECTOR=#dashboard

# --- Track 2b: x402 buyer (pakai @x402/fetch lewat sidecar Node) ---
BUYER_PRIVATE_KEY=0xBUYER_WALLET_WITH_USDC
X402_ENDPOINT=https://contoh-endpoint-berbayar/premium
X402_MAX_AMOUNT=100000
X402_MAX_USD=$1
# Seller x402 lokal (buka x402.celo.org, connect wallet + GitHub login utk credit)
X402_API_KEY=
SELLER_PAY_TO=0xSAMA_DENGAN_PAYOUT_ADDRESS
X402_SELLER_PORT=3402
X402_PRICE=100000

# --- Track 4: Altana (SDK TS via Bun) ---
ALTANA_ADMIN_PRIVATE_KEY=0xADMIN_WALLET_PRIVATE_KEY
ALTANA_SPEND_LIMIT=1000000
ALTANA_EXPIRY_SECONDS=86400
ALTANA_REVOKE=1
